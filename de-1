\begin{ex}
Hàm số $y=2x^3-2x^2-2x+1$ đồng biến trên khoảng nào sau đây?
\choice
{$(-1;1)$}
{$(-\infty;1)$}
{$(0;2)$}
{\True $(1;2)$}
\end{ex}

\begin{ex}
Hàm số $y=\dfrac{x+3}{x-2}$ nghịch biến trên khoảng nào sau đây?
\choice
{$(-2;3)$}
{$(-\infty;3)$}
{$(-\infty;+\infty)$}
{\True $(3;+\infty)$}
\end{ex}

\begin{ex}
Cho hàm số $y=\dfrac{x-3}{x+1}$. Mệnh đề nào dưới đây đúng?
\choice
{Hàm số đồng biến trên $\mathbb{R}\setminus\{-1\}$.}
{Hàm số nghịch biến trên $(-\infty;-1)$.}
{Hàm số đồng biến trên $(-\infty;+\infty)$.}
{\True Hàm số đồng biến trên $(-\infty;-1)$.}
\end{ex}

\begin{ex}
Cho hàm số $y=\dfrac{x+2}{x-1}$. Xét các mệnh đề sau:
\begin{enumerate}[1)]
    \item Hàm số đã cho đồng biến trên $(1;+\infty)$.
    \item Hàm số đã cho nghịch biến trên $\mathbb{R}\setminus\{1\}$.
    \item Hàm số đã cho không có điểm cực trị.
    \item Hàm số đã cho nghịch biến trên các khoảng $(-\infty;1)$ và $(1;+\infty)$.
\end{enumerate}
Số các mệnh đề \textbf{đúng} là
\choice
{$4$.}
{\True $2$.}
{$3$.}
{$1$.}
\end{ex}

\begin{ex}
Cho hàm số $y=f(x)$ có đạo hàm $f'(x)=(x+1)(2x-5)^2$ với mọi $x\in\mathbb{R}$. Hàm số đã cho nghịch biến trên khoảng nào?
\choice
{\True $(-\infty;-1)$.}
{$(-1;3)$.}
{$(-1;+\infty)$.}
{$(-3;1)$.}
\end{ex}

\begin{ex}
Cho hàm số $y=f(x)$ liên tục trên $\mathbb{R}$ và có đạo hàm $f'(x)=(x+1)(x-1)^4(2-x)$. Mệnh đề nào dưới đây đúng?
\choice
{$f(5)>f(4)>f(3)$}
{$f(-1)>f(0)>f(1)$}
{$f(-3)<f(-2)<f(-1)$}
{\True $f(0)<f(1)<f(2)$}
\end{ex}

\begin{ex}
Cho hàm số $f(x)$ xác định trên $\mathbb{R}$ và có đạo hàm $f'(x)=(2-x)(x+1)^2(x-1)^5$. Hàm số đã cho nghịch biến trên khoảng nào dưới đây?
\choice
{$(-\infty;2)$}
{\True $(2;+\infty)$}
{$(-1;2)$}
{$(1;+\infty)$}
\end{ex}

\textbf{Phần 2. Trắc nghiệm đúng sai}
\setcounter{ex}{0}

\begin{ex}
Cho hàm số $y=\dfrac{x-1}{x+2}$.
\choiceTF
{Tập xác định của hàm số là $D=\mathbb{R}$}
{Hàm số nghịch biến trên $\mathbb{R}\setminus\{-2\}$}
{Hàm số đồng biến trên $\mathbb{R}\setminus\{-2\}$}
{\True Hàm số đồng biến trên các khoảng $(-\infty;-2)$ và $(-2;+\infty)$}
\end{ex}

\begin{ex}
Cho hàm số $y=\sqrt{x^2+1}$
\choiceTF
{Hàm số đạt cực đại tại $x=0$}
{Hàm số không có cực trị.}
{\True Hàm số đạt cực tiểu tại $x=0$}
{Hàm số có hai điểm cực trị}
\end{ex}

\begin{ex}
Xét một chất điểm chuyển động dọc theo trục $Ox$. Toạ độ của chất điểm tại thời điểm $t$ được xác định bởi hàm số $x(t)=t^3-6t^2+9t$ với $t \ge 0$. Khi đó $x'(t)$ là vận tốc của chất điểm tại thời điểm $t$, kí hiệu $v(t)$; $v'(t)$ là gia tốc chuyển động của chất điểm tại thời điểm $t$, kí hiệu $a(t)$.
\choiceTF
{Phương trình hàm vận tốc là $v(t)=3t^2-6t+9$.}
{\True Phương trình hàm gia tốc là $a(t)=6t-12$.}
{Vận tốc của chất điểm tăng khi $t \in (0;1) \cup (3;+\infty)$.}
{Vận tốc của chất điểm giảm khi $t \in (1;3)$.}
\end{ex}

\begin{ex}
Cho hàm số $y=\dfrac{x^2+x-1}{x-1}$
\choiceTF
{\True Tập xác định của hàm số là $D=\mathbb{R} \setminus \{1\}$}
{\True Phương trình $y'=0$ có hai nghiệm nguyên}
{Hàm số đồng biến trên mỗi khoảng $(0;1)$ và $(2;+\infty)$}
{\True Hàm số nghịch biến trên mỗi khoảng $(0;1)$ và $(1;2)$.}
\end{ex}

\textbf{Phần 3. Trả lời ngắn}
\setcounter{ex}{0}

\begin{ex}
Cho hàm số $y=x^3-3x^2+5$ có đồ thị $(C)$. Tính độ dài đoạn thẳng nối hai điểm cực trị của đồ thị $(C)$ (Kết quả làm tròn đến hàng phần trăm).
\shortans{4.47}
\end{ex}

\begin{ex}
Biết hàm số $y=ax^3+bx^2+cx+d$ có hai điểm cực trị là $(-1;18)$ và $(3;-16)$. Tính giá trị biểu thức $P=a+b+c+d$.
\shortans{1}
\end{ex}

\begin{ex}
Đồ thị của hàm số $y=x^3-3x^2-9x+1$ có hai điểm cực trị là $A$ và $B$. Tính khoảng cách từ gốc toạ độ $O$ đến đường thẳng $AB$ (Kết quả làm tròn đến hàng phần trăm). 
\shortans{0.25}
\end{ex}

\begin{ex}
Biết đồ thị $(C)$ của hàm số $y=\dfrac{x^2-4x+5}{x-1}$ có hai điểm cực trị. Đường thẳng đi qua hai điểm cực trị của đồ thị hàm số $(C)$ tạo với hai trục toạ độ một tam giác có diện tích $S$ bằng bao nhiêu?
\shortans{4}
\end{ex}

\begin{ex}
Gọi $A,B,C$ là ba điểm cực trị của đồ thị hàm số $y=x^4-2x^2+4$. Bán kính đường tròn nội tiếp tam giác $ABC$ bằng bao nhiêu?(Kết quả làm tròn đến hàng phần trăm)
\shortans{0.41}
\end{ex}

\begin{ex}
Cho hàm số $y=ax^3+bx^2+cx+d$ đạt cực trị tại các điểm $x_1, x_2$ thỏa mãn $x_1 \in (-1;0), x_2 \in (1;2)$. Biết hàm số đồng biến trên khoảng $(x_1;x_2)$. Đồ thị hàm số cắt trục tung tại điểm có tung độ âm. Trong các số $a,b$ và $c$ có bao nhiêu số âm?
\shortans{1}
\end{ex}
